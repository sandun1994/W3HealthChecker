APP_NAME=W3HealthChecker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://w3healthchecker.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (PostgreSQL / MySQL recommended for production; SQLite for dev)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=w3healthchecker
# DB_USERNAME=w3_user
# DB_PASSWORD=secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=w3_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notifications@w3healthchecker.com"
MAIL_FROM_NAME="${APP_NAME}"

# Scanner Pipeline & Security Hardening Controls
SCAN_TIMEOUT_CONNECT=5
SCAN_TIMEOUT_TOTAL=15
SCAN_MAX_RESPONSE_BYTES=5242880
SCAN_MAX_REDIRECTS=5

# Rate Limiting & Abuse Prevention Controls
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW=60
MAX_CONCURRENT_SCANS=5
SCAN_CACHE_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
